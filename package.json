{
  "name": "zipstream-worker",
  "version": "1.0.0",
  "description": "Stream individual files out of a remote ZIP archive at the edge — no extraction, no storage, constant memory. A Cloudflare Workers reference implementation.",
  "keywords": [
    "cloudflare",
    "workers",
    "zip",
    "streaming",
    "range-requests",
    "deflate",
    "edge",
    "serverless",
    "zip64"
  ],
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "main": "src/index.ts",
  "scripts": {
    "dev": "wrangler dev",
    "start": "wrangler dev",
    "deploy": "wrangler deploy",
    "build": "wrangler deploy --dry-run --outdir dist",
    "typecheck": "tsc --noEmit",
    "cf-typegen": "wrangler types",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test",
    "probe": "node scripts/probe-archive.mjs",
    "bench": "node benchmarks/bench.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.1",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.7.0",
    "prettier": "^3.3.3",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.15.0",
    "vitest": "^4.1.10",
    "wrangler": "^4.20.5"
  }
}
