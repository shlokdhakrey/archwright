{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    /* Language & module output tuned for the Workers runtime (ESM, modern V8). */
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022"],
    // Runtime types come solely from the wrangler-generated
    // `worker-configuration.d.ts` (see `include`). `types: []` prevents any
    // ambient @types package (e.g. @types/node) from leaking Node globals into
    // the Worker's global scope, matching Cloudflare's current guidance.
    "types": [],

    /* Strictness — the whole point of the project. */
    "strict": true,
    "noImplicitOverride": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "allowUnusedLabels": false,
    "allowUnreachableCode": false,
    "forceConsistentCasingInFileNames": true,
    "useUnknownInCatchVariables": true,

    /* Interop & ergonomics. */
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["src", "tests", "vitest.config.ts", "worker-configuration.d.ts"],
  "exclude": ["node_modules", "dist", ".wrangler"]
}
